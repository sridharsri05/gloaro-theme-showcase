# ---- Google Sheets (server-side only, set in Vercel → Project → Settings → Environment Variables) ----
# Service account email, e.g. gloaro-leads@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service-account JSON. Keep the \n escapes; the API converts them.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID of the "GLOARO Business Enquiries" spreadsheet (from its URL /d/<ID>/edit)
GOOGLE_SHEET_ID=
# Tab name inside the spreadsheet
GOOGLE_SHEET_TAB=Enquiries

# ---- Email notification (SMTP, e.g. Gmail App Password, Zoho, SendGrid SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GLOARO Leads <no-reply@gloaro.com>"
NOTIFY_EMAIL=business@gloaro.com

# Public base URL of the deployment (used to build Theme URLs in sheet/email)
SITE_URL=https://your-project.vercel.app
